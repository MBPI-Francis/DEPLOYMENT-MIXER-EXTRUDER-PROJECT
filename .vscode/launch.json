{
    "version": "0.2.0",
    "configurations": [
        {
        "name": "Python Debugger: Current File",
        "type": "debugpy",
        "request": "launch",
        "program": "${file}",
        "console": "integratedTerminal",
        "env": {
            "PYTHONPATH": "${workspaceFolder}"
        }
        },
        {
        "name": "Debug PyQt6 App",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder}/main.py",
        "console": "integratedTerminal",
        "justMyCode": false,
        "envFile": "${workspaceFolder}/.env"
        }
    ]
}